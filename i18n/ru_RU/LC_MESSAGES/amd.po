#: amd.i18n.php:4
msgid "AMD"
msgstr "AMD"

#: amd.i18n.php:10 views/settings.php:5
msgid "AMD Settings"
msgstr "Настройка AMD"

#: views/settings.php:69
msgid "After Greeting Silence"
msgstr "Пауза после приветствия"

#: amd.i18n.php:6
msgid "Applications"
msgstr "Приложения"

#: views/settings.php:165
msgid "Between Words Silence"
msgstr "Паузы между словами"

#: views/settings.php:45
msgid "Greeting"
msgstr "Приветствие"

#: views/settings.php:21
msgid "Initial Silence"
msgstr "Пауза перед разговором"

#: views/settings.php:189
msgid "Maximum Number Of Words"
msgstr "Максимальное количество слов"

#: views/settings.php:141
msgid "Maximum Word Length"
msgstr "Максимальная длина слова"

#: views/settings.php:153
msgid "Maximum duration of a single Voice utterance allowed. Default is 5000."
msgstr "Максимальная продолжительность звучания одного голоса. По умолчанию - 5000."

#: views/settings.php:57
msgid ""
"Maximum length of a greeting. If exceeded then MACHINE. Default is 1500."
msgstr ""
"Максимальная длина приветствия. Если она превышена, то МАШИНА. По умолчанию 1500."

#: views/settings.php:201
msgid "Maximum number of words in the greeting. Default is 3."
msgstr "Максимальное количество слов в приветствии. По умолчанию - 3."

#: views/settings.php:33
msgid "Maximum silence duration before the greeting. Default is 2500."
msgstr "Максимальная продолжительность молчания перед приветствием. По умолчанию - 2500."

#: views/settings.php:105
msgid "Maximum time allowed for the algorithm to decide. Default is 5000."
msgstr "Максимальное время, отведенное алгоритму на принятие решения. По умолчанию - 5000."

#: views/settings.php:117
msgid "Minimum Word Length"
msgstr "Минимальная длина слова"

#: views/settings.php:129
msgid "Minimum duration of Voice to considered as a word. Default is 100."
msgstr "Минимальная продолжительность звучания голоса, которая будет считаться словом. По умолчанию - 100."

#: views/settings.php:177
msgid "Minimum duration of silence after a word to consider. Default is 50."
msgstr "Минимальная продолжительность тишины после слова, которую следует учитывать. По умолчанию - 50."

#: Amd.class.php:42
msgid "Reset"
msgstr "Сброс настроек"

#: install.php:21
msgid "Restoring the existing settings"
msgstr "Восстановление существующих настроек"

#: views/settings.php:213
msgid "Silence Threshold"
msgstr "Порог молчания"

#: views/settings.php:225
msgid "Silence Threshold. Default is 256."
msgstr "Пороговое значение тишины."

#: views/settings.php:81
msgid "Silence after detecting a greeting. Default is 800."
msgstr "Тишина после обнаружения приветствия. По умолчанию - 800."

#: Amd.class.php:42
msgid "Submit"
msgstr "Сохранить"

#: amd.i18n.php:8
msgid ""
"This module is used to manage AMD. The AMD application attempts to detect "
"answering machines at the beginning of outbound calls"
msgstr ""
Этот модуль используется для управления AMD. Приложение AMD пытается обнаружить "
"автоответчики в начале исходящих вызовов"

#: views/settings.php:93
msgid "Total Analysis Time"
msgstr "Общее время анализа"

#: install.php:10
msgid "amd.conf Configuration file found"
msgstr "Конфигурационный файл amd.conf найден"
